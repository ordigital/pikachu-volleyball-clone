# Force HTTPS on the canonical host
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

AddType application/wasm .wasm
# The game is served pre-compressed (brotli -q 11, built by ports/browser/build.sh). Letting the CDN compress the
# 7 MB file on the fly was ~4x slower and delivered it in big bursts, so the loading bar sat at 0%.
<IfModule mod_headers.c>
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.*\.wasm)$ $1.br [L]
  <FilesMatch "\.wasm\.br$">
    ForceType application/wasm
    Header set Content-Encoding br
    Header set Cache-Control "public, max-age=86400, no-transform"
  </FilesMatch>
  <FilesMatch "\.wasm$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
AddDefaultCharset UTF-8
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>
# Static assets are not fingerprinted: rename a file (or bump its ?v=) when you change it.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
